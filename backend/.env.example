# Copia este archivo como ".env" y coloca tus datos reales

PORT=4000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_password_de_mysql
DB_NAME=reparoxpress

JWT_SECRET=cambia_esto_por_una_clave_larga_y_secreta
JWT_EXPIRES_IN=8h

# --- Emisión electrónica ante el SII (boleta/factura con validez tributaria) ---
# Déjalas así (o vacías) mientras no tengas un proveedor DTE conectado.
# El sistema funciona igual de bien sin esto; solo habilita el botón
# "Emitir DTE (SII)" en Documentos de Venta. Ver backend/services/dteProvider.js
# para instrucciones de cómo conectar un proveedor real.
DTE_PROVIDER=none
DTE_API_URL=
DTE_API_KEY=

# --- Envío de comprobante por correo al cliente ---
# Déjalas vacías mientras no las configures: la venta se sigue guardando
# igual, solo no se envía el correo. Ver backend/services/mailer.js para
# instrucciones completas.
#
# OPCIÓN RECOMENDADA si el backend está en Railway/Render (evita el
# bloqueo de puertos SMTP de esos hostings):
RESEND_API_KEY=
#
# OPCIÓN ALTERNATIVA (SMTP tradicional — mejor para uso 100% local):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=ReparoXpress
